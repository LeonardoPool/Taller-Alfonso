{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/admin/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/stargate/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/admin/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/empleados/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/empleados/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/zafiro/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/empleados/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/admin/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/empleados/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/empleados",
      "destination": "/empleados/",
      "permanent": false
    },
    {
      "source": "/public",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/public/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/public/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stargate",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/stargate/",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/stargate/index.html",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/zafiro",
      "destination": "/empleados/",
      "permanent": false
    },
    {
      "source": "/zafiro/",
      "destination": "/empleados/",
      "permanent": false
    },
    {
      "source": "/zafiro/index.html",
      "destination": "/empleados/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/.firebaserc",
      "destination": "/404.html"
    },
    {
      "source": "/firebase.json",
      "destination": "/404.html"
    },
    {
      "source": "/.vscode/:match*",
      "destination": "/404.html"
    },
    {
      "source": "/admin/sw.js",
      "destination": "/stargate/sw.js"
    },
    {
      "source": "/admin/manifest.json",
      "destination": "/stargate/manifest.json"
    },
    {
      "source": "/admin/icons/:match*",
      "destination": "/stargate/icons/:match*"
    },
    {
      "source": "/empleados/sw.js",
      "destination": "/zafiro/sw.js"
    },
    {
      "source": "/empleados/manifest.json",
      "destination": "/zafiro/manifest.json"
    },
    {
      "source": "/empleados/icons/:match*",
      "destination": "/zafiro/icons/:match*"
    },
    {
      "source": "/admin/",
      "destination": "/stargate/index.html"
    },
    {
      "source": "/admin/index",
      "destination": "/stargate/index.html"
    },
    {
      "source": "/admin/index.html",
      "destination": "/stargate/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/stargate/dashboard.html"
    },
    {
      "source": "/admin/dashboard.html",
      "destination": "/stargate/dashboard.html"
    },
    {
      "source": "/admin/almacen",
      "destination": "/stargate/almacen.html"
    },
    {
      "source": "/admin/almacen.html",
      "destination": "/stargate/almacen.html"
    },
    {
      "source": "/admin/clientes",
      "destination": "/stargate/clientes.html"
    },
    {
      "source": "/admin/clientes.html",
      "destination": "/stargate/clientes.html"
    },
    {
      "source": "/admin/empleados",
      "destination": "/stargate/empleados.html"
    },
    {
      "source": "/admin/empleados.html",
      "destination": "/stargate/empleados.html"
    },
    {
      "source": "/admin/trabajos",
      "destination": "/stargate/trabajos.html"
    },
    {
      "source": "/admin/trabajos.html",
      "destination": "/stargate/trabajos.html"
    },
    {
      "source": "/admin/formulariocliente",
      "destination": "/stargate/formulariocliente.html"
    },
    {
      "source": "/admin/formulariocliente.html",
      "destination": "/stargate/formulariocliente.html"
    },
    {
      "source": "/admin/formularioempleado",
      "destination": "/stargate/formularioempleado.html"
    },
    {
      "source": "/admin/formularioempleado.html",
      "destination": "/stargate/formularioempleado.html"
    },
    {
      "source": "/admin/formulariotrabajo",
      "destination": "/stargate/formulariotrabajo.html"
    },
    {
      "source": "/admin/formulariotrabajo.html",
      "destination": "/stargate/formulariotrabajo.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/stargate/:match*"
    },
    {
      "source": "/empleados/",
      "destination": "/zafiro/index.html"
    },
    {
      "source": "/empleados/index",
      "destination": "/zafiro/index.html"
    },
    {
      "source": "/empleados/index.html",
      "destination": "/zafiro/index.html"
    },
    {
      "source": "/empleados/admin",
      "destination": "/zafiro/admin.html"
    },
    {
      "source": "/empleados/admin.html",
      "destination": "/zafiro/admin.html"
    },
    {
      "source": "/empleados/formulariotrabajos",
      "destination": "/zafiro/formulariotrabajos.html"
    },
    {
      "source": "/empleados/formulariotrabajos.html",
      "destination": "/zafiro/formulariotrabajos.html"
    },
    {
      "source": "/empleados/:match*",
      "destination": "/zafiro/:match*"
    }
  ]
}
