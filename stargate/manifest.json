{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/admin/",
  "name": "DEFCON5 Admin",
  "short_name": "D5 Admin",
  "description": "Portal Administrativo y de Gestión de DEFCON5 - Taller Mecánico",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#0F172A",
  "lang": "es-MX",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "url": "/admin/dashboard.html",
      "description": "Ver resumen y prioridades del taller"
    },
    {
      "name": "Almacén",
      "url": "/admin/almacen.html",
      "description": "Control de inventario de piezas"
    },
    {
      "name": "Trabajos",
      "url": "/admin/trabajos.html",
      "description": "Gestión de trabajos activos y completados"
    },
    {
      "name": "Clientes",
      "url": "/admin/clientes.html",
      "description": "Directorio de clientes y empresas"
    }
  ]
}
